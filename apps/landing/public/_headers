# Fingerprinted by the build, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Image Transformations inherit their cache lifetime from these originals.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Extensionless files keep their URLs from the Next.js site.
/opengraph-image
  Content-Type: image/png
/resources/opengraph-image-5fam9d
  Content-Type: image/png
/og/blog/*
  Content-Type: image/png
/api/search
  Content-Type: application/json

# The extension alone would give text/mdx and application/xml.
/docs/*.mdx
  Content-Type: text/markdown
/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# One URL, two representations: src/server.ts picks the twin by Accept. A path
# can only appear once in this file, so /docs.mdx keeps both of its headers here.
/docs
  Vary: Accept
/docs.mdx
  Content-Type: text/markdown
  Vary: Accept
/docs/*
  Vary: Accept
/blog/*
  Vary: Accept

# Loader results for client navigation, not pages.
/data/*
  X-Robots-Tag: noindex

# The default domain mirrors the site and must stay out of search results.
https://pipe0-landing.florian-martens22.workers.dev/*
  X-Robots-Tag: noindex

/*
  Strict-Transport-Security: max-age=63072000
